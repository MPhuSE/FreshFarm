              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_id\": 1,\n  \"payment_method\": \"cod\",\n  \"coupon_code\": \"XANH10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/checkout/preview",
              "host": ["{{baseUrl}}"],
              "path": ["checkout", "preview"]
            }
          }
        },
        {
          "name": "Đặt hàng (Place Order)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "3b123a12-8731-4ca6-8b8d-22c899b5a100" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_id\": 1,\n  \"payment_method\": \"cod\",\n  \"coupon_code\": \"XANH10\",\n  \"note\": \"Giao hàng sáng mai\",\n  \"idempotency_key\": \"3b123a12-8731-4ca6-8b8d-22c899b5a100\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Danh sách đơn hàng của tôi",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Chi tiết đơn hàng theo order_code",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/NSX-20260915-1234",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "NSX-20260915-1234"]
            }
          }
        },
        {
          "name": "Hủy đơn hàng",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Thay đổi nhu cầu mua hàng\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/NSX-20260915-1234/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "NSX-20260915-1234", "cancel"]
            }
          }
        }
      ]
    },
